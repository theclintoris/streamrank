# StreamRank addon configuration
# Copy to .env and edit as needed. No API key is required.

PORT=7100

# Public origin used in manifest/logo URLs. Leave blank to use the request host.
# Example: https://streamrank.example.com
PUBLIC_URL=

# Storefront region: US, GB, CA, AU, NZ, DE
REGION=US

# Catalog cache lifetime in milliseconds (10 minutes)
CACHE_TTL_MS=600000

# Upstream JustWatch request timeout in milliseconds
JUSTWATCH_TIMEOUT_MS=12000

# Optional override for testing
# JUSTWATCH_ENDPOINT=https://apis.justwatch.com/graphql
